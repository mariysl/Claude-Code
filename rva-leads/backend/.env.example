# ─── Twilio SMS Credentials ────────────────────────────────────────────────
# Get these from twilio.com/console after signing up for a free account.
# Your Account SID and Auth Token are on the main console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number you purchased (must be SMS-capable).
# Format: +1XXXXXXXXXX  (include country code, no spaces)
TWILIO_FROM_NUMBER=+18045550000

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
